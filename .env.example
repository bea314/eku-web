# Nest API base — Crop so-microservicio (PR #3 / measured SHA).
# ALREADY includes /api (no trailing slash after).
# Paths: ${PUBLIC_API_BASE_URL}/events → http://localhost:3000/api/events
#
# Local default may be localhost. Production (Vercel) MUST set a public URL —
# never localhost. See docs/deploy/VERCEL.md.
#
# Seed org (Crop): johndoe@correo.com.sv / Password123
#   POST /api/auth/sign-in → data.items.accessToken (store raw JWT)
PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional alias (same shape, with /api). Used if PUBLIC_API_BASE_URL is empty.
# PUBLIC_API_URL=http://localhost:3000/api

# Optional server-only override (same shape, with /api).
# API_BASE_URL=http://localhost:3000/api
