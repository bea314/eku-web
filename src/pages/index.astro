---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getApiBaseUrl } from '../lib/api';

const apiBase = getApiBaseUrl();
---

<BaseLayout title="ekü" description="Eventos y planes en El Salvador — reservá gratis.">
  {!apiBase && (
    <div class="alert alert--error" role="alert">
      Falta <code>PUBLIC_API_BASE_URL</code>. Copia <code>.env.example</code> → <code>.env</code> y reinicia el servidor.
    </div>
  )}

  <!-- U19: curated entry — NOT a twin of /eventos browse -->
  <section class="home-curated" aria-labelledby="home-curated-title">
    <header class="home-curated__head">
      <p class="eyebrow">Inicio</p>
      <h1 id="home-curated-title">Planes cerca</h1>
      <p class="muted home-curated__lead">Categorías y unas recomendaciones. El listado completo está en Eventos.</p>
    </header>

    <div class="cat-row cat-row--home" id="cats" role="navigation" aria-label="Categorías" hidden></div>

    <div class="home-curated__section">
      <div class="home-curated__row">
        <h2 class="home-curated__label">Recomendados</h2>
        <a class="home-curated__all" href="/eventos">Ver todos</a>
      </div>
      <div id="status" class="alert alert--info" hidden></div>
      <div id="list" class="event-grid event-grid--home" aria-live="polite"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { asItemList, clientApi, ClientApiError, getStoredToken } from '../lib/client-api';
  import { bindHeartStubs, eventCardHtml } from '../lib/card-ui';
  import { escapeHtml } from '../lib/safe-display';

  type EventItem = Record<string, unknown> & { id: string };
  type Category = { id: number | string; name: string; slug?: string | null; icon?: string | null };

  /** Curated home: few cards only — full browse is /eventos */
  const HOME_LIMIT = 4;

  const status = document.getElementById('status')!;
  const list = document.getElementById('list')!;
  const cats = document.getElementById('cats')!;

  function showStatus(msg: string, tone: 'error' | 'info' | 'ok' = 'info') {
    status.hidden = false;
    status.className = `alert alert--${tone}`;
    status.textContent = msg;
  }

  function renderList(items: EventItem[]) {
    if (!items.length) {
      const extra = getStoredToken()
        ? '<p style="margin-top:1rem"><a class="btn btn--primary" href="/organizador">Crear evento</a></p>'
        : '';
      list.innerHTML = `<div class="empty"><p><strong>Todavía no hay eventos públicos.</strong></p><p class="muted">Cuando alguien publique uno, aparece acá.</p>${extra}</div>`;
      return;
    }
    list.innerHTML = items.map((e, i) => eventCardHtml(e, i)).join('');
    bindHeartStubs(list);
  }

  function renderCategories(items: Category[]) {
    if (!items.length) {
      cats.hidden = true;
      cats.innerHTML = '';
      return;
    }
    // Chips deep-link into browse — not a twin filter on home
    const cards = items.map((c) => {
      const id = String(c.id);
      const href = `/eventos?categoryIds=${encodeURIComponent(id)}`;
      const icon = c.icon
        ? `<span class="cat-card__icon" aria-hidden="true">${escapeHtml(String(c.icon))}</span>`
        : '';
      return `<a class="cat-card" href="${href}">
        ${icon}
        <span class="cat-card__name">${escapeHtml(c.name)}</span>
      </a>`;
    });
    cats.innerHTML = cards.join('');
    cats.hidden = false;
  }

  async function loadCategories() {
    try {
      const data = await clientApi<Category[] | { items?: Category[] }>('/catalog/categories');
      renderCategories(
        asItemList(data).filter(
          (c) => c && c.id != null && String(c.id) !== '' && typeof c.name === 'string' && c.name,
        ),
      );
    } catch {
      cats.hidden = true;
      cats.innerHTML = '';
    }
  }

  async function loadRecommendations() {
    showStatus('Cargando planes…', 'info');
    try {
      const data = await clientApi<EventItem[] | { items?: EventItem[] }>('/events');
      const items = asItemList(data).slice(0, HOME_LIMIT);
      status.hidden = true;
      renderList(items);
    } catch (err) {
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error desconocido';
      showStatus(`No se pudo cargar: ${msg}`, 'error');
      list.innerHTML = '';
    }
  }

  void loadCategories();
  void loadRecommendations();
</script>
