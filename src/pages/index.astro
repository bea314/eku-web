---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getApiBaseUrl } from '../lib/api';

const apiBase = getApiBaseUrl();
---

<BaseLayout title="ekü" description="Eventos y planes en El Salvador — reservá gratis.">
  {!apiBase && (
    <div class="alert alert--error" role="alert">
      Falta <code>PUBLIC_API_BASE_URL</code>. Copia <code>.env.example</code> → <code>.env</code> y reinicia el servidor.
    </div>
  )}

  <!-- U5: no marketing hero. Featured only if Nest has a cover event; else hidden. -->
  <a id="featured" class="home-featured" href="#" hidden></a>

  <div class="chip-row" id="chips" role="group" aria-label="Categorías">
    <button class="chip is-active" type="button" data-cat="all">Todos</button>
    <button class="chip" type="button" data-cat="musica">Música</button>
    <button class="chip" type="button" data-cat="cultura">Cultura</button>
    <button class="chip" type="button" data-cat="comida">Comida</button>
    <button class="chip" type="button" data-cat="comunidad">Comunidad</button>
  </div>

  <div class="section-head">
    <h2>Planes cerca</h2>
    <a class="muted" href="/eventos">Ver listado →</a>
  </div>

  <div id="status" class="alert alert--info" hidden></div>
  <div id="list" class="event-grid" aria-live="polite"></div>
</BaseLayout>

<script>
  import { asItemList, clientApi, ClientApiError } from '../lib/client-api';
  import { bindHeartStubs, eventCardHtml } from '../lib/card-ui';
  import {
    coverUrlOf,
    escapeHtml,
    formatEventWhen,
    formatPlace,
    formatTitle,
    safeString,
  } from '../lib/safe-display';

  type EventItem = Record<string, unknown> & { id: string };

  const status = document.getElementById('status')!;
  const list = document.getElementById('list')!;
  const featured = document.getElementById('featured') as HTMLAnchorElement;
  const chips = document.getElementById('chips')!;

  let allItems: EventItem[] = [];
  let activeCat = 'all';

  function showStatus(msg: string, tone: 'error' | 'info' | 'ok' = 'info') {
    status.hidden = false;
    status.className = `alert alert--${tone}`;
    status.textContent = msg;
  }

  function categoryOf(e: EventItem): string {
    const blob = `${safeString(e.category)} ${safeString(e.name)} ${safeString(e.title)} ${safeString(e.description)}`.toLowerCase();
    if (/música|musica|concert|dj|jazz|live/.test(blob)) return 'musica';
    if (/comida|food|gastro|café|cafe|bar/.test(blob)) return 'comida';
    if (/cultura|arte|teatro|cine|expo|museo/.test(blob)) return 'cultura';
    return 'comunidad';
  }

  /** Promo banner only when Nest has a cover; hide if empty. */
  function renderFeatured(items: EventItem[]) {
    const pick =
      items.find((e) => coverUrlOf(e) && (e.featured === true || e.isFeatured === true)) ||
      items.find((e) => coverUrlOf(e)) ||
      null;

    if (!pick) {
      featured.hidden = true;
      featured.removeAttribute('href');
      featured.innerHTML = '';
      return;
    }

    const cover = coverUrlOf(pick);
    if (!cover) {
      featured.hidden = true;
      featured.innerHTML = '';
      return;
    }

    const when = formatEventWhen(pick);
    featured.hidden = false;
    featured.href = `/eventos/${encodeURIComponent(String(pick.id))}`;
    featured.innerHTML = `
      <div class="home-featured__media"><img src="${escapeHtml(cover)}" alt="" /></div>
      <div class="home-featured__body">
        <span class="home-featured__eyebrow">Destacado</span>
        <h2>${escapeHtml(formatTitle(pick))}</h2>
        <p>${escapeHtml(when.full)} · ${escapeHtml(formatPlace(pick))}</p>
        <span class="home-featured__cta">Ver plan →</span>
      </div>
    `;
  }

  function renderList() {
    const filtered =
      activeCat === 'all' ? allItems : allItems.filter((e) => categoryOf(e) === activeCat);
    if (!filtered.length) {
      list.innerHTML =
        '<div class="empty"><p><strong>No hay planes en esta categoría.</strong></p><p class="muted">Probá “Todos” o publicá uno desde Organizador.</p></div>';
      return;
    }
    list.innerHTML = filtered
      .map((e, i) => eventCardHtml(e, i, `data-cat="${categoryOf(e)}"`))
      .join('');
    bindHeartStubs(list);
  }

  chips.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('button.chip') as HTMLButtonElement | null;
    if (!btn) return;
    activeCat = btn.dataset.cat || 'all';
    chips.querySelectorAll('.chip').forEach((c) => c.classList.toggle('is-active', c === btn));
    renderList();
  });

  async function load() {
    showStatus('Buscando planes…', 'info');
    try {
      const data = await clientApi<EventItem[] | { items?: EventItem[] }>('/events');
      allItems = asItemList(data);
      status.hidden = true;
      renderFeatured(allItems);
      if (!allItems.length) {
        featured.hidden = true;
        list.innerHTML =
          '<div class="empty"><p><strong>Todavía no hay eventos públicos.</strong></p><p class="muted">Cuando un organizador publique uno, aparece acá.</p><p style="margin-top:1rem"><a class="btn btn--primary" href="/organizador">Ir a organizador</a></p></div>';
        return;
      }
      renderList();
    } catch (err) {
      featured.hidden = true;
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error desconocido';
      showStatus(`No se pudo cargar: ${msg}`, 'error');
      list.innerHTML = '';
    }
  }

  load();
</script>
