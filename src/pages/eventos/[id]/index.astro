---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const invite = Astro.url.searchParams.get('invite') || '';
const openReserve = Astro.url.searchParams.get('reserve') === '1';
---

<BaseLayout title="Detalle · ekü">
  <div
    id="root"
    data-event-id={id}
    data-invite={invite}
    data-open-reserve={openReserve ? '1' : ''}
  >
    <div class="alert alert--info">Cargando evento…</div>
  </div>

  <div id="checkout-modal" class="modal-backdrop" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="checkout-modal-title">
      <div class="modal__head">
        <h2 id="checkout-modal-title">Reservar gratis</h2>
        <button class="modal__close" type="button" id="checkout-modal-close" aria-label="Cerrar">×</button>
      </div>
      <form class="form" id="checkout-modal-form">
        <label>
          Tipo
          <select name="ticketTypeId" required></select>
        </label>
        <div class="row two">
          <label>
            Cantidad
            <input name="quantity" type="number" min="1" value="1" required />
          </label>
          <label>
            Email
            <input name="email" type="email" required placeholder="tu@email.com" autocomplete="email" />
          </label>
        </div>
        <label class="form-check">
          <input name="acceptedTerms" type="checkbox" checked required />
          Acepto los términos
        </label>
        <div id="checkout-modal-status" hidden></div>
        <button class="btn btn--primary btn--block" type="submit">Confirmar</button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    asItemList,
    clientApi,
    ClientApiError,
    getOrCreateGuestSessionId,
  } from '../../../lib/client-api';
  import {
    brandCoverPlaceholderHtml,
    coverUrlOf,
    escapeHtml,
    formatPlace,
    formatTitle,
    formatWhenLong,
    hostAvatarUrl,
    hostLabel,
    pickStartRaw,
    safeString,
  } from '../../../lib/safe-display';
  import type { CheckoutConfirmRequest, CheckoutPreviewRequest } from '../../../lib/types';
  import { savePaseConfirm } from '../../../lib/pase';

  type TicketType = {
    id: string | number;
    name?: unknown;
    price?: unknown;
    currency?: string;
    remaining?: number | null;
    available?: number | null;
    quantityAvailable?: number | null;
    capacity?: number | null;
    sold?: number | null;
  };

  type EventItem = Record<string, unknown> & {
    id: string;
    ticketTypes?: TicketType[];
  };

  const root = document.getElementById('root')!;
  const eventId = root.dataset.eventId || '';
  const invite = root.dataset.invite || '';
  const openReserve = root.dataset.openReserve === '1';

  const modal = document.getElementById('checkout-modal')!;
  const modalForm = document.getElementById('checkout-modal-form') as HTMLFormElement;
  const modalStatus = document.getElementById('checkout-modal-status')!;
  const ticketSelect = modalForm.elements.namedItem('ticketTypeId') as HTMLSelectElement;

  let ticketsCache: TicketType[] = [];
  let eventCache: EventItem | null = null;

  function stockOf(tt: TicketType): number | null {
    for (const c of [tt.remaining, tt.available, tt.quantityAvailable]) {
      if (typeof c === 'number') return c;
    }
    if (typeof tt.capacity === 'number' && typeof tt.sold === 'number') {
      return Math.max(0, tt.capacity - tt.sold);
    }
    if (typeof tt.capacity === 'number') return tt.capacity;
    return null;
  }

  function priceOf(n: unknown, currency = 'USD') {
    const num = typeof n === 'number' ? n : Number(n);
    if (!Number.isFinite(num) || num === 0) return 'Gratis';
    try {
      return new Intl.NumberFormat('es', { style: 'currency', currency }).format(num);
    } catch {
      return `${currency} ${num}`;
    }
  }

  function firstNameFromEmail(email: string): string {
    const local = email.split('@')[0] || '';
    const cleaned = local.replace(/[._+-]+/g, ' ').trim();
    if (!cleaned) return 'Guest';
    return cleaned
      .split(/\s+/)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ')
      .slice(0, 64);
  }

  function openModal(availableOnly = true) {
    const options = ticketsCache
      .map((t) => {
        const s = stockOf(t);
        const sold = s !== null && s <= 0;
        if (availableOnly && sold) return '';
        return `<option value="${escapeHtml(String(t.id))}" ${sold ? 'disabled' : ''}>${escapeHtml(safeString(t.name) || 'Entrada')} · ${escapeHtml(priceOf(t.price, t.currency))}</option>`;
      })
      .filter(Boolean)
      .join('');
    ticketSelect.innerHTML = options || '<option value="">Sin tipos</option>';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.getElementById('checkout-modal-close')!.addEventListener('click', closeModal);
  modal.addEventListener('click', (ev) => {
    if (ev.target === modal) closeModal();
  });

  modalForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(modalForm);
    const ticketTypeId = String(fd.get('ticketTypeId') || '');
    const quantity = Number(fd.get('quantity') || 1);
    const email = String(fd.get('email') || '').trim();
    const accepted = (modalForm.elements.namedItem('acceptedTerms') as HTMLInputElement)?.checked;
    if (!accepted) {
      modalStatus.hidden = false;
      modalStatus.className = 'alert alert--error';
      modalStatus.textContent = 'Aceptá los términos.';
      return;
    }
    const eventTicketTypeId = Number(ticketTypeId);
    if (!Number.isFinite(eventTicketTypeId)) {
      modalStatus.hidden = false;
      modalStatus.className = 'alert alert--error';
      modalStatus.textContent = 'Tipo inválido.';
      return;
    }

    const payload: CheckoutConfirmRequest = {
      eventId,
      items: [{ eventTicketTypeId, quantity }],
      acceptedTerms: true,
      guest: {
        email,
        guestSessionId: getOrCreateGuestSessionId(),
        firstName: firstNameFromEmail(email),
      },
    };
    if (invite) payload.inviteToken = invite;
    const previewPayload: CheckoutPreviewRequest = { ...payload };

    modalStatus.hidden = false;
    modalStatus.className = 'alert alert--info';
    modalStatus.textContent = 'Confirmando…';

    try {
      try {
        await clientApi('/checkout/preview', { method: 'POST', body: previewPayload });
      } catch (previewErr) {
        if (previewErr instanceof ClientApiError && previewErr.status === 404) {
          // ok
        } else if (previewErr instanceof ClientApiError && previewErr.status >= 400) {
          throw previewErr;
        }
      }

      // Crop: data.items → { tickets[], qrPayloads[], orderId? } (unwrapEnvelope)
      const result = await clientApi<{
        orderId?: string;
        id?: string;
        tickets?: Array<{
          id?: string;
          code?: string;
          ticketCode?: string;
          qrPayload?: string;
          ticketTypeName?: string;
          eventName?: string;
        }>;
        items?: Array<{ id?: string; code?: string; ticketCode?: string; qrPayload?: string }>;
        qrPayloads?: string[];
      }>('/checkout/confirm', { method: 'POST', body: payload });

      const orderId = result.orderId || result.id || '';
      const ticketsOut = Array.isArray(result.tickets)
        ? result.tickets
        : Array.isArray(result.items)
          ? result.items
          : [];
      const qrs = [
        ...(Array.isArray(result.qrPayloads) ? result.qrPayloads : []),
        ...ticketsOut.map((t) => t.qrPayload || '').filter(Boolean),
      ].filter((q, i, arr) => arr.indexOf(q) === i);

      savePaseConfirm({
        orderId,
        email,
        eventId,
        eventName: typeof eventCache?.name === 'string' ? eventCache.name : undefined,
        tickets: ticketsOut,
        qrPayloads: qrs,
      });
      window.location.href = `/confirmacion?orderId=${encodeURIComponent(orderId)}`;
    } catch (err) {
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error';
      modalStatus.className = 'alert alert--error';
      modalStatus.textContent = msg;
    }
  });

  async function load() {
    try {
      const event = await clientApi<EventItem>(`/events/${encodeURIComponent(eventId)}`, {
        searchParams: { invite: invite || undefined },
      });
      eventCache = event;

      let tickets: TicketType[] = [];
      let ticketTypesError = '';
      try {
        const tt = await clientApi<TicketType[] | { items?: TicketType[] }>(
          `/events/${encodeURIComponent(eventId)}/ticket-types`,
          { searchParams: { invite: invite || undefined } },
        );
        tickets = asItemList(tt);
        if (!tickets.length && Array.isArray(event.ticketTypes)) {
          tickets = event.ticketTypes;
        }
      } catch (err) {
        tickets = Array.isArray(event.ticketTypes) ? event.ticketTypes : [];
        if (!tickets.length) {
          ticketTypesError =
            err instanceof ClientApiError ? err.message : 'sin tipos de ticket';
        }
      }
      ticketsCache = tickets;

      const hostName = hostLabel(event);
      const avatar = hostAvatarUrl(event);
      const starts = pickStartRaw(event);

      const soldOut =
        tickets.length > 0 &&
        tickets.every((t) => {
          const s = stockOf(t);
          return s !== null && s <= 0;
        });

      const ticketsHtml = ticketTypesError
        ? `<div class="alert alert--error">ticket-types: ${escapeHtml(ticketTypesError)}</div>`
        : tickets.length === 0
          ? '<p class="muted">Sin tipos de ticket en la respuesta API.</p>'
          : tickets
              .map((t) => {
                const s = stockOf(t);
                const out = s !== null && s <= 0;
                const stockLabel =
                  s === null ? 'Cupo no informado' : out ? 'Agotado' : `${s} disponibles`;
                return `<div class="ticket ${out ? 'is-soldout' : ''}">
                  <div>
                    <div class="ticket__name">${escapeHtml(t.name)}</div>
                    <div class="muted">${escapeHtml(stockLabel)}</div>
                  </div>
                  <div class="ticket__price">${escapeHtml(priceOf(t.price, t.currency))}</div>
                </div>`;
              })
              .join('');

      const hostInitial = hostName ? hostName.slice(0, 1).toUpperCase() : 'Ü';
      const hostHtml = hostName
        ? `<div class="host">
            ${
              avatar
                ? `<img class="host__avatar" src="${escapeHtml(avatar)}" alt="" />`
                : `<div class="host__avatar host__avatar--fallback" aria-hidden="true">${escapeHtml(hostInitial)}</div>`
            }
            <div>
              <div class="muted" style="font-size:0.78rem;letter-spacing:0.06em;text-transform:uppercase;font-weight:600">Hosted by</div>
              <strong>${escapeHtml(hostName)}</strong>
            </div>
          </div>`
        : `<div class="alert alert--info">El anfitrión no vino en la API todavía (A9).</div>`;

      const cover = coverUrlOf(event);
      const coverHtml = cover
        ? `<div class="detail-cover"><img src="${escapeHtml(cover)}" alt="" /></div>`
        : `<div class="detail-cover">${brandCoverPlaceholderHtml('detail')}</div>`;

      const title = formatTitle(event);
      document.title = `${title} · ekü`;

      const visibility = safeString(event.visibility);
      const inviteCopyBlock =
        visibility === 'private'
          ? `<div class="panel stack" style="margin-top:1rem">
              <h3 class="section-title" style="margin:0">Invitación</h3>
              <p class="muted" style="margin:0">${
                invite ? 'Entraste con un link válido.' : 'Sin invite no se puede reservar.'
              }</p>
              ${
                invite
                  ? `<button class="btn btn--ghost" type="button" id="copy-invite-link">Copiar link de invitación</button>`
                  : ''
              }
            </div>`
          : '';

      const ctaBlock = soldOut
        ? `<div class="event-full-banner">Evento lleno — tipos de ticket agotados.</div>
           <button class="btn btn--ghost btn--block btn--lg" type="button" id="waitlist-btn">Join Waiting List</button>
           <p class="muted" style="margin:0;font-size:0.82rem">UI only — no se guarda lista de espera (U10).</p>`
        : `<button class="btn btn--primary btn--block btn--lg" type="button" id="checkout-cta">Reservar gratis</button>`;

      root.innerHTML = `
        <a class="crumb" href="/eventos">← Eventos</a>
        <div class="detail-layout">
          ${coverHtml}
          <div class="detail-panel">
            <section class="detail-hero">
              <p class="eyebrow">Registro gratis</p>
              <h1>${escapeHtml(title)}</h1>
              ${
                safeString(event.description)
                  ? `<p class="muted" style="max-width:36rem;margin:0">${escapeHtml(event.description)}</p>`
                  : ''
              }
            </section>
            <div class="detail-meta">
              <div class="detail-meta__row">
                <span class="detail-meta__label">Cuándo</span>
                <span>${escapeHtml(formatWhenLong(starts))}</span>
              </div>
              <div class="detail-meta__row">
                <span class="detail-meta__label">Dónde</span>
                <span>${escapeHtml(formatPlace(event))}</span>
              </div>
            </div>
            ${hostHtml}
            ${invite ? `<p class="muted" style="margin:0">Entraste con invitación privada.</p>` : ''}
            ${inviteCopyBlock}
            <aside class="panel panel--ticket stack">
              <h2 class="section-title">Tipos de ticket <span class="free-tag">$0</span></h2>
              <div>${ticketsHtml}</div>
              ${ctaBlock}
            </aside>
          </div>
        </div>
      `;

      document.getElementById('checkout-cta')?.addEventListener('click', () => openModal(true));
      document.getElementById('waitlist-btn')?.addEventListener('click', () => {
        const toast = document.getElementById('nav-toast');
        if (toast) {
          toast.hidden = false;
          toast.textContent = 'Waiting list — UI stub. No se persiste.';
          window.setTimeout(() => {
            toast.hidden = true;
          }, 2400);
        }
      });

      const copyBtn = document.getElementById('copy-invite-link');
      if (copyBtn && invite) {
        copyBtn.addEventListener('click', async () => {
          const link = `${window.location.origin}/eventos/${encodeURIComponent(eventId)}?invite=${encodeURIComponent(invite)}`;
          try {
            await navigator.clipboard.writeText(link);
            copyBtn.textContent = 'Link copiado';
          } catch {
            copyBtn.textContent = link;
          }
        });
      }

      if (openReserve && !soldOut) openModal(true);
    } catch (err) {
      const status = err instanceof ClientApiError ? err.status : 0;
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error';
      const hint =
        status === 403 || status === 401 || status === 404
          ? ' Si el evento es privado, necesitás el link con invitación.'
          : '';
      root.innerHTML = `<div class="alert alert--error" role="alert">No se pudo abrir el evento: ${escapeHtml(msg)}.${hint}</div>
        <p style="margin-top:1rem"><a class="btn btn--ghost" href="/eventos">Volver a eventos</a></p>`;
    }
  }

  load();
</script>
