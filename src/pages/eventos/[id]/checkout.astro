---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const { id } = Astro.params;
const invite = Astro.url.searchParams.get('invite') || '';
---

<BaseLayout title="Reservar · ekü" description="Reservá tu entrada — demo gratis.">
  <div class="page--narrow" style="margin-inline:auto">
    <a class="crumb" href={`/eventos/${id}${invite ? `?invite=${encodeURIComponent(invite)}` : ''}`}>
      ← Volver al evento
    </a>
    <section class="page-hero">
      <p class="eyebrow">Un paso</p>
      <h1>Reservar entrada</h1>
      <p>Sin cuenta. Solo tu email — registro gratis ($0).</p>
    </section>

    <div
      id="checkout-root"
      class="panel"
      data-event-id={id}
      data-invite={invite}
    >
      <div class="alert alert--info">Cargando opciones…</div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    clientApi,
    ClientApiError,
    getOrCreateGuestSessionId,
  } from '../../../lib/client-api';
  import { asItemList } from '../../../lib/client-api';
  import { escapeHtml } from '../../../lib/safe-display';
  import type { CheckoutConfirmRequest, CheckoutPreviewRequest } from '../../../lib/types';

  type TicketType = {
    id: string | number;
    name: string;
    price: number;
    currency?: string;
    remaining?: number | null;
    available?: number | null;
    quantityAvailable?: number | null;
    capacity?: number | null;
    sold?: number | null;
  };

  const root = document.getElementById('checkout-root')!;
  const eventId = root.dataset.eventId || '';
  const invite = root.dataset.invite || '';

  function stockOf(tt: TicketType): number | null {
    for (const c of [tt.remaining, tt.available, tt.quantityAvailable]) {
      if (typeof c === 'number') return c;
    }
    if (typeof tt.capacity === 'number' && typeof tt.sold === 'number') {
      return Math.max(0, tt.capacity - tt.sold);
    }
    if (typeof tt.capacity === 'number') return tt.capacity;
    return null;
  }

  function priceOf(n: number) {
    return n === 0 ? 'Gratis' : String(n);
  }

  function firstNameFromEmail(email: string): string {
    const local = email.split('@')[0] || '';
    const cleaned = local.replace(/[._+-]+/g, ' ').trim();
    if (!cleaned) return 'Guest';
    return cleaned
      .split(/\s+/)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ')
      .slice(0, 64);
  }

  /** Nest PR #3 cart body — eventTicketTypeId is integer */
  function buildCheckoutBody(
    ticketTypeIdRaw: string,
    quantity: number,
    email: string,
    inviteToken: string,
  ): CheckoutConfirmRequest {
    const eventTicketTypeId = Number(ticketTypeIdRaw);
    if (!Number.isFinite(eventTicketTypeId)) {
      throw new ClientApiError('Tipo de entrada inválido (eventTicketTypeId)', 400);
    }
    const body: CheckoutConfirmRequest = {
      eventId,
      items: [{ eventTicketTypeId, quantity }],
      acceptedTerms: true,
      guest: {
        email,
        guestSessionId: getOrCreateGuestSessionId(),
        firstName: firstNameFromEmail(email),
      },
    };
    if (inviteToken) body.inviteToken = inviteToken;
    return body;
  }

  async function load() {
    try {
      const raw = await clientApi<TicketType[] | { items?: TicketType[] }>(
        `/events/${encodeURIComponent(eventId)}/ticket-types`,
        { searchParams: { invite: invite || undefined } },
      );
      const tickets = asItemList(raw);
      if (!tickets.length) {
        root.innerHTML =
          '<div class="alert alert--error">No hay tipos de ticket disponibles para este evento.</div>';
        return;
      }

      const options = tickets
        .map((t) => {
          const s = stockOf(t);
          const disabled = s !== null && s <= 0;
          const label = `${t.name} · ${priceOf(t.price)}${s !== null ? ` · ${s} disp.` : ''}`;
          return `<option value="${escapeHtml(String(t.id))}" data-stock="${s ?? ''}" ${disabled ? 'disabled' : ''}>${escapeHtml(label)}</option>`;
        })
        .join('');

      root.innerHTML = `
        <form class="form" id="checkout-form">
          <label>
            Tipo de entrada
            <select name="ticketTypeId" required>${options}</select>
          </label>
          <div class="row two">
            <label>
              Cantidad
              <input name="quantity" type="number" min="1" value="1" required />
            </label>
            <label>
              Tu email
              <input name="email" type="email" required placeholder="tu@email.com" autocomplete="email" />
            </label>
          </div>
          ${invite ? `<input type="hidden" name="invite" value="${escapeHtml(invite)}" />` : ''}
          <label class="form-check">
            <input name="acceptedTerms" type="checkbox" checked required />
            Acepto los términos de la reserva
          </label>
          <div id="form-status" hidden></div>
          <button class="btn btn--primary btn--block btn--lg" type="submit">Confirmar reserva gratis</button>
        </form>
      `;

      const form = document.getElementById('checkout-form') as HTMLFormElement;
      const status = document.getElementById('form-status')!;

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(form);
        const ticketTypeId = String(fd.get('ticketTypeId') || '');
        const quantity = Number(fd.get('quantity') || 1);
        const email = String(fd.get('email') || '').trim();
        const inviteToken = String(fd.get('invite') || invite || '');
        const accepted = (form.elements.namedItem('acceptedTerms') as HTMLInputElement)?.checked;

        if (!accepted) {
          status.hidden = false;
          status.className = 'alert alert--error';
          status.textContent = 'Debés aceptar los términos para continuar.';
          return;
        }

        status.hidden = false;
        status.className = 'alert alert--info';
        status.textContent = 'Confirmando…';

        // Nest PR #3: items[], acceptedTerms, inviteToken, guest — no Bearer
        let payload: CheckoutConfirmRequest;
        try {
          payload = buildCheckoutBody(ticketTypeId, quantity, email, inviteToken);
        } catch (buildErr) {
          const msg =
            buildErr instanceof ClientApiError
              ? buildErr.message
              : buildErr instanceof Error
                ? buildErr.message
                : 'Payload inválido';
          status.className = 'alert alert--error';
          status.textContent = msg;
          return;
        }

        const previewPayload: CheckoutPreviewRequest = { ...payload };

        try {
          try {
            await clientApi('/checkout/preview', {
              method: 'POST',
              body: previewPayload,
            });
          } catch (previewErr) {
            if (previewErr instanceof ClientApiError && previewErr.status === 404) {
              // endpoint missing on older Nest — continue
            } else if (previewErr instanceof ClientApiError && previewErr.status >= 400) {
              // A8: surface Nest 400 (e.g. over-qty) from preview
              throw previewErr;
            }
          }

          // Guest confirm: intentionally no token / Authorization
          const result = await clientApi<{
            orderId?: string;
            id?: string;
            tickets?: Array<{ id?: string; code?: string; ticketCode?: string; qrPayload?: string }>;
            items?: Array<{ id?: string; code?: string; ticketCode?: string; qrPayload?: string }>;
            qrPayloads?: string[];
            email?: string;
          }>('/checkout/confirm', { method: 'POST', body: payload });

          const orderId = result.orderId || result.id || '';
          const ticketsOut = result.tickets || result.items || [];
          const codes = ticketsOut
            .map((t) => t.code || t.ticketCode || t.id || '')
            .filter(Boolean);
          const qrs = [
            ...(result.qrPayloads || []),
            ...ticketsOut.map((t) => t.qrPayload || '').filter(Boolean),
          ];
          const evidence = [...codes, ...qrs.filter((q) => !codes.includes(q))].join(',');

          const qs = new URLSearchParams({
            orderId,
            email,
            evidence,
            eventId,
          });
          if (qrs.length) qs.set('qr', qrs.join(','));
          window.location.href = `/confirmacion?${qs.toString()}`;
        } catch (err) {
          // A8: Nest 400 message (stock / validation) shown as-is
          const msg =
            err instanceof ClientApiError
              ? err.message
              : err instanceof Error
                ? err.message
                : 'Error';
          status.className = 'alert alert--error';
          status.textContent = `No se pudo confirmar: ${msg}`;
        }
      });
    } catch (err) {
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error';
      root.innerHTML = `<div class="alert alert--error">No se pudo iniciar la reserva: ${escapeHtml(msg)}</div>`;
    }
  }

  load();
</script>
