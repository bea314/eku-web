---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getApiBaseUrl } from '../../lib/api';

const apiBase = getApiBaseUrl();
---

<BaseLayout title="Eventos · ekü" description="Listado de eventos y planes cerca de ti.">
  {!apiBase && (
    <div class="alert alert--error" role="alert">
      Falta <code>PUBLIC_API_BASE_URL</code>. Copia <code>.env.example</code> → <code>.env</code> y reinicia el servidor.
    </div>
  )}

  <form class="discovery-search" id="discovery-search" role="search" autocomplete="off">
    <label class="visually-hidden" for="discovery-q">Buscar eventos</label>
    <span class="discovery-search__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8" />
        <path d="M16.2 16.2 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </span>
    <input
      id="discovery-q"
      class="discovery-search__input"
      type="search"
      name="q"
      placeholder="Buscar eventos…"
      enterkeyhint="search"
    />
  </form>

  <div class="cat-row" id="cats" role="group" aria-label="Categorías" hidden></div>

  <div id="status" class="alert alert--info" hidden></div>
  <div id="list" class="event-grid" aria-live="polite"></div>
</BaseLayout>

<script>
  import { asItemList, clientApi, ClientApiError } from '../../lib/client-api';
  import { bindHeartStubs, eventCardHtml } from '../../lib/card-ui';
  import { escapeHtml } from '../../lib/safe-display';

  type EventItem = Record<string, unknown> & { id: string };
  type Category = { id: string; name: string; slug?: string | null; icon?: string | null };

  const status = document.getElementById('status')!;
  const list = document.getElementById('list')!;
  const cats = document.getElementById('cats')!;
  const searchForm = document.getElementById('discovery-search') as HTMLFormElement;
  const searchInput = document.getElementById('discovery-q') as HTMLInputElement;

  let activeCategoryId = '';
  let query = '';
  let searchTimer = 0;
  let loadSeq = 0;

  function showStatus(msg: string, tone: 'error' | 'info' | 'ok' = 'info') {
    status.hidden = false;
    status.className = `alert alert--${tone}`;
    status.textContent = msg;
  }

  function renderList(items: EventItem[]) {
    if (!items.length) {
      list.innerHTML =
        '<div class="empty"><p><strong>No hay eventos con ese filtro.</strong></p><p class="muted">Probá otra búsqueda o categoría.</p></div>';
      return;
    }
    list.innerHTML = items.map((e, i) => eventCardHtml(e, i)).join('');
    bindHeartStubs(list);
  }

  function renderCategories(items: Category[]) {
    if (!items.length) {
      cats.hidden = true;
      cats.innerHTML = '';
      return;
    }
    const cards = [
      `<button class="cat-card is-active" type="button" data-category-id="" aria-pressed="true">
        <span class="cat-card__name">Todos</span>
      </button>`,
      ...items.map((c) => {
        const icon = c.icon
          ? `<span class="cat-card__icon" aria-hidden="true">${escapeHtml(String(c.icon))}</span>`
          : '';
        return `<button class="cat-card" type="button" data-category-id="${escapeHtml(c.id)}" aria-pressed="false">
          ${icon}
          <span class="cat-card__name">${escapeHtml(c.name)}</span>
        </button>`;
      }),
    ];
    cats.innerHTML = cards.join('');
    cats.hidden = false;
  }

  async function loadCategories() {
    try {
      const data = await clientApi<Category[] | { items?: Category[] }>('/categories');
      renderCategories(asItemList(data).filter((c) => c && typeof c.id === 'string' && c.name));
    } catch (err) {
      // Nest Crop gap: /categories may 404 until Crop lands — hide chips, no mocks.
      if (err instanceof ClientApiError && (err.status === 404 || err.status === 501)) {
        cats.hidden = true;
        cats.innerHTML = '';
        return;
      }
      cats.hidden = true;
      cats.innerHTML = '';
    }
  }

  async function loadEvents() {
    const seq = ++loadSeq;
    showStatus('Buscando eventos…', 'info');
    try {
      const data = await clientApi<EventItem[] | { items?: EventItem[] }>('/events', {
        searchParams: {
          q: query || undefined,
          categoryId: activeCategoryId || undefined,
        },
      });
      if (seq !== loadSeq) return;
      const items = asItemList(data);
      status.hidden = true;
      if (!items.length) {
        if (!query && !activeCategoryId) {
          list.innerHTML =
            '<div class="empty"><p><strong>Todavía no hay eventos públicos.</strong></p><p class="muted">Cuando un organizador publique uno, aparece acá.</p><p style="margin-top:1rem"><a class="btn btn--primary" href="/organizador">Ir a organizador</a></p></div>';
          return;
        }
        renderList([]);
        return;
      }
      renderList(items);
    } catch (err) {
      if (seq !== loadSeq) return;
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error desconocido';
      showStatus(`No se pudo cargar la lista: ${msg}`, 'error');
      list.innerHTML = '';
    }
  }

  cats.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('button.cat-card') as HTMLButtonElement | null;
    if (!btn) return;
    activeCategoryId = btn.dataset.categoryId || '';
    cats.querySelectorAll('.cat-card').forEach((c) => {
      const on = c === btn;
      c.classList.toggle('is-active', on);
      c.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    void loadEvents();
  });

  searchForm.addEventListener('submit', (ev) => {
    ev.preventDefault();
    query = searchInput.value.trim();
    void loadEvents();
  });

  searchInput.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      query = searchInput.value.trim();
      void loadEvents();
    }, 280);
  });

  void loadCategories();
  void loadEvents();
</script>
