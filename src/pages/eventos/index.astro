---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getApiBaseUrl } from '../../lib/api';

const apiBase = getApiBaseUrl();
---

<BaseLayout title="ekü" description="Eventos y cultura local cerca de ti.">
  <section class="page-hero page-hero--brand">
    <p class="eyebrow">Cultura local</p>
    <h1>ekü</h1>
    <p>Encontrá lo que está pasando cerca — y reservá gratis en un paso.</p>
  </section>

  {!apiBase && (
    <div class="alert alert--error" role="alert">
      Falta <code>PUBLIC_API_BASE_URL</code>. Copia <code>.env.example</code> → <code>.env</code> y reinicia el servidor.
    </div>
  )}

  <div id="status" class="alert alert--info" hidden></div>
  <div id="list" class="event-grid" aria-live="polite"></div>
</BaseLayout>

<script>
  import { asItemList, clientApi, ClientApiError } from '../../lib/client-api';

  type EventItem = {
    id: string;
    name?: string;
    title?: string;
    startsAt?: string;
    startAt?: string;
    startDate?: string;
    place?: string;
    placeText?: string;
    location?: string;
    locationText?: string;
    venue?: string;
    isVirtual?: boolean;
    virtual?: boolean;
    visibility?: string;
    coverUrl?: string;
    imageUrl?: string;
  };

  function titleOf(e: EventItem) {
    return e.name || e.title || 'Evento sin título';
  }

  function placeOf(e: EventItem) {
    if (e.isVirtual || e.virtual) return 'Virtual';
    return e.place || e.placeText || e.locationText || e.location || e.venue || 'Lugar por confirmar';
  }

  function coverOf(e: EventItem) {
    return e.coverUrl || e.imageUrl || '';
  }

  function partsOf(e: EventItem) {
    const iso = e.startsAt || e.startAt || e.startDate;
    if (!iso) {
      return { month: '—', day: '?', time: '', full: 'Fecha por confirmar' };
    }
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) {
      return { month: '—', day: '?', time: '', full: iso };
    }
    return {
      month: new Intl.DateTimeFormat('es', { month: 'short' }).format(d).replace('.', ''),
      day: String(d.getDate()),
      time: new Intl.DateTimeFormat('es', { hour: '2-digit', minute: '2-digit' }).format(d),
      full: new Intl.DateTimeFormat('es', {
        weekday: 'short',
        day: 'numeric',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
      }).format(d),
    };
  }

  const status = document.getElementById('status')!;
  const list = document.getElementById('list')!;

  function showStatus(msg: string, tone: 'error' | 'info' | 'ok' = 'info') {
    status.hidden = false;
    status.className = `alert alert--${tone}`;
    status.textContent = msg;
  }

  function escapeHtml(s: string) {
    return s
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  async function load() {
    showStatus('Buscando eventos…', 'info');
    try {
      const data = await clientApi<EventItem[] | { items?: EventItem[] }>('/events');
      const items = asItemList(data);
      status.hidden = true;
      if (!items.length) {
        list.innerHTML =
          '<div class="empty"><p><strong>Todavía no hay eventos públicos.</strong></p><p class="muted">Cuando un organizador publique uno, aparece acá.</p><p style="margin-top:1rem"><a class="btn btn--mint" href="/organizador">Ir a organizador</a></p></div>';
        return;
      }
      list.innerHTML = items
        .map((e, i) => {
          const when = partsOf(e);
          const cover = coverOf(e);
          const media = cover
            ? `<img src="${escapeHtml(cover)}" alt="" loading="lazy" />`
            : `<div class="event-card__media-fallback"><span>ekü</span></div>`;
          const badge =
            e.visibility && e.visibility !== 'public'
              ? `<span class="badge">${escapeHtml(e.visibility)}</span>`
              : '';
          return `<a class="event-card" href="/eventos/${encodeURIComponent(e.id)}" style="animation-delay:${Math.min(i, 8) * 35}ms">
            <div class="event-card__media">
              ${media}
              <div class="event-card__date-chip" aria-label="${escapeHtml(when.full)}">
                <span class="month">${escapeHtml(when.month)}</span>
                <span class="day">${escapeHtml(when.day)}</span>
              </div>
            </div>
            <div class="event-card__body">
              <h2>${escapeHtml(titleOf(e))}</h2>
              <div class="event-card__meta">
                <span>${escapeHtml(when.time ? `${when.full}` : when.full)}</span>
                <span>${escapeHtml(placeOf(e))}</span>
                ${badge}
              </div>
              <div class="event-card__cta">
                <span class="event-card__price">Gratis</span>
                <span class="event-card__action">Ver evento →</span>
              </div>
            </div>
          </a>`;
        })
        .join('');
    } catch (err) {
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error desconocido';
      showStatus(`No se pudo cargar la lista: ${msg}`, 'error');
      list.innerHTML = '';
    }
  }

  load();
</script>
