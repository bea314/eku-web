---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Crear cuenta · ekü" description="Registrate en ekü con email y contraseña.">
  <div class="auth-page">
    <section class="auth-card">
      <p class="eyebrow">Cuenta</p>
      <h1>Crear cuenta</h1>
      <p class="muted auth-card__lead">Email y contraseña. Después podés publicar eventos con tu usuario.</p>

      <form class="form form--auth" id="register-form" novalidate>
        <label>
          Nombre
          <input
            name="firstName"
            type="text"
            autocomplete="given-name"
            placeholder="Cómo te decimos"
          />
        </label>
        <label>
          Email
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="tu@email.com"
          />
        </label>
        <label>
          Contraseña
          <input
            name="password"
            type="password"
            autocomplete="new-password"
            required
            minlength="8"
            placeholder="Mínimo 8 caracteres"
          />
        </label>
        <div id="register-status" hidden></div>
        <button class="btn btn--primary btn--block" type="submit">Crear cuenta</button>
      </form>

      <p class="auth-card__footer muted">
        ¿Ya tenés cuenta?
        <a id="login-link" href="/login">Entrar</a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { ClientApiError } from '../../lib/client-api';
  import { isLoggedIn, safeNextPath, signUp } from '../../lib/auth-session';

  const params = new URLSearchParams(window.location.search);
  const next = safeNextPath(params.get('next'), '/perfil');
  const loginLink = document.getElementById('login-link') as HTMLAnchorElement;
  loginLink.href = `/login?next=${encodeURIComponent(next)}`;

  if (isLoggedIn()) {
    window.location.replace(next);
  }

  const form = document.getElementById('register-form') as HTMLFormElement;
  const status = document.getElementById('register-status')!;

  function show(msg: string, kind: 'info' | 'ok' | 'error') {
    status.hidden = false;
    status.className = `alert alert--${kind === 'ok' ? 'ok' : kind === 'error' ? 'error' : 'info'}`;
    status.textContent = msg;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(form);
    const email = String(fd.get('email') || '').trim();
    const password = String(fd.get('password') || '');
    const firstName = String(fd.get('firstName') || '').trim();
    if (!email || !password) {
      show('Completá email y contraseña.', 'error');
      return;
    }
    if (password.length < 8) {
      show('La contraseña necesita al menos 8 caracteres.', 'error');
      return;
    }
    show('Creando cuenta…', 'info');
    try {
      await signUp({
        email,
        password,
        firstName: firstName || undefined,
        displayName: firstName || undefined,
      });
      show('Cuenta lista.', 'ok');
      window.location.href = next;
    } catch (err) {
      const msg = err instanceof ClientApiError ? err.message : err instanceof Error ? err.message : 'Error';
      show(msg, 'error');
    }
  });
</script>
