---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Organizador · ekü" description="Publicá y editá tus eventos en ekü.">
  <section class="page-hero">
    <p class="eyebrow">Organizador</p>
    <h1>Publicá en minutos</h1>
    <p>Entrá, completá el evento y publicá. Después podés editar o crear un link de invitación.</p>
  </section>

  <div class="steps" id="org-steps" aria-hidden="true">
    <span class="step-pill is-active" data-step="1"><span class="n">1</span> Entrar</span>
    <span class="step-pill" data-step="2"><span class="n">2</span> Publicar</span>
    <span class="step-pill" data-step="3"><span class="n">3</span> Gestionar</span>
  </div>

  <div class="stack" id="org-app">
    <section class="panel" id="auth-panel">
      <h2 class="section-title">1 · Entrar</h2>
      <p class="muted" style="margin:-0.4rem 0 1rem">
        Seed org (Crop): <code class="mono">johndoe@correo.com.sv</code> / <code class="mono">Password123</code>
        · o pegá un JWT.
      </p>
      <form class="form" id="auth-form">
        <div class="row two">
          <label>
            Email
            <input name="email" type="email" autocomplete="username" value="johndoe@correo.com.sv" />
          </label>
          <label>
            Password
            <input name="password" type="password" autocomplete="current-password" placeholder="Password123" />
          </label>
        </div>
        <label>
          Token (Bearer JWT) — opcional si usás login
          <textarea name="token" rows="2" placeholder="eyJhbGciOi…"></textarea>
        </label>
        <div id="auth-status" hidden></div>
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap">
          <button class="btn" type="submit" name="action" value="login">Entrar</button>
          <button class="btn btn--ghost" type="submit" name="action" value="save">Usar token</button>
          <button class="btn btn--ghost" type="button" id="logout-btn">Salir</button>
        </div>
      </form>
    </section>

    <div class="org-layout" id="workspace" hidden>
      <section class="panel" id="create-panel">
        <h2 class="section-title">2 · Crear y publicar</h2>
        <p class="muted" style="margin:-0.4rem 0 1rem">
          Nest requiere <code class="mono">description</code>, <code class="mono">startDate</code>, <code class="mono">endDate</code> y
          <code class="mono">location</code> con coords al publicar.
        </p>
        <form class="form" id="create-form">
          <label>
            Nombre del evento
            <input name="name" required placeholder="Noche de jazz en el patio" />
          </label>
          <label>
            Descripción
            <textarea name="description" rows="3" required placeholder="Qué pasa, para quién, vibe…"></textarea>
          </label>
          <div class="row two">
            <label>
              Inicio (startDate)
              <input name="startDate" type="datetime-local" required />
            </label>
            <label>
              Fin (endDate)
              <input name="endDate" type="datetime-local" required />
            </label>
          </div>
          <label>
            Quién puede verlo
            <select name="visibility" required>
              <option value="public">Público — en la lista</option>
              <option value="unlisted">No listado — solo con link</option>
              <option value="private">Privado — con invitación</option>
            </select>
          </label>
          <label>
            Lugar (nombre / dirección)
            <input name="place" required placeholder="Café Central" />
          </label>
          <div class="row two">
            <label>
              Lat
              <input name="lat" type="number" step="any" value="13.6929" required />
            </label>
            <label>
              Lng
              <input name="lng" type="number" step="any" value="-89.2182" required />
            </label>
          </div>
          <div class="row two">
            <label>
              Tipo de entrada
              <input name="ticketName" value="General" required />
            </label>
            <label>
              Precio (demo $0)
              <input name="ticketPrice" type="number" min="0" step="0.01" value="0" required />
            </label>
          </div>
          <label>
            Capacidad (opcional)
            <input name="capacity" type="number" min="1" placeholder="ej. 40" />
          </label>
          <label class="form-check">
            <input name="publish" type="checkbox" checked />
            Publicar ahora
          </label>
          <div id="create-status" hidden></div>
          <button class="btn btn--mint btn--lg" type="submit">Publicar evento</button>
        </form>
      </section>

      <div class="stack">
        <section class="panel" id="list-panel">
          <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap">
            <h2 class="section-title" style="margin:0">3 · Tus eventos</h2>
            <button class="btn btn--ghost" type="button" id="refresh-btn">Actualizar</button>
          </div>
          <div id="mine-status" class="alert alert--info" style="margin-top:1rem" hidden></div>
          <div id="mine-list" class="stack" style="margin-top:0.75rem"></div>
        </section>

        <section class="panel" id="edit-panel" hidden>
          <h2 class="section-title">Editar</h2>
          <form class="form" id="edit-form">
            <input type="hidden" name="id" />
            <label>
              Nombre
              <input name="name" required />
            </label>
            <label>
              Descripción
              <textarea name="description" rows="2"></textarea>
            </label>
            <div class="row two">
              <label>
                Inicio (startDate)
                <input name="startDate" type="datetime-local" required />
              </label>
              <label>
                Fin (endDate)
                <input name="endDate" type="datetime-local" required />
              </label>
            </div>
            <label>
              Lugar
              <input name="place" />
            </label>
            <div class="row two">
              <label>
                Lat
                <input name="lat" type="number" step="any" />
              </label>
              <label>
                Lng
                <input name="lng" type="number" step="any" />
              </label>
            </div>
            <label>
              Visibilidad
              <select name="visibility">
                <option value="public">Público</option>
                <option value="unlisted">No listado</option>
                <option value="private">Privado</option>
              </select>
            </label>
            <div id="edit-status" hidden></div>
            <div style="display:flex;gap:0.6rem;flex-wrap:wrap">
              <button class="btn" type="submit">Guardar cambios</button>
              <button class="btn btn--ghost" type="button" id="cancel-edit">Cerrar</button>
            </div>
          </form>
          <div id="invite-box" style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line)" hidden>
            <h3 style="margin:0 0 0.35rem;font-size:1rem">Link de invitación</h3>
            <p class="muted" style="margin:0 0 0.75rem">Para eventos privados: creá el link y compartilo.</p>
            <button class="btn btn--ghost" type="button" id="invite-btn">Crear y copiar link</button>
            <p id="invite-result" class="mono" style="margin-top:0.75rem;word-break:break-all"></p>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    asItemList,
    clientApi,
    ClientApiError,
    clearStoredToken,
    getStoredToken,
    setStoredToken,
  } from '../../lib/client-api';
  import {
    escapeHtml,
    formatPlace,
    formatTitle,
    formatWhenParts,
    fromLocalInputValue,
    pickEndRaw,
    pickStartRaw,
    safeString,
    toLocalInputValue,
  } from '../../lib/safe-display';

  type EventItem = Record<string, unknown> & { id: string };

  const authForm = document.getElementById('auth-form') as HTMLFormElement;
  const authStatus = document.getElementById('auth-status')!;
  const authPanel = document.getElementById('auth-panel')!;
  const workspace = document.getElementById('workspace')!;
  const createForm = document.getElementById('create-form') as HTMLFormElement;
  const editForm = document.getElementById('edit-form') as HTMLFormElement;
  const editPanel = document.getElementById('edit-panel')!;
  const createStatus = document.getElementById('create-status')!;
  const editStatus = document.getElementById('edit-status')!;
  const mineStatus = document.getElementById('mine-status')!;
  const mineList = document.getElementById('mine-list')!;
  const inviteBox = document.getElementById('invite-box')!;
  const inviteResult = document.getElementById('invite-result')!;
  const tokenField = authForm.elements.namedItem('token') as HTMLTextAreaElement;
  const stepPills = document.querySelectorAll<HTMLElement>('.step-pill');

  function show(el: HTMLElement, msg: string, tone: 'error' | 'ok' | 'info') {
    el.hidden = false;
    el.className = `alert alert--${tone}`;
    el.textContent = msg;
  }

  function visibilityLabel(v?: string) {
    if (v === 'unlisted') return 'No listado';
    if (v === 'private') return 'Privado';
    if (v === 'public') return 'Público';
    return v || '';
  }

  function locationCoords(e: EventItem): { lat?: number; lng?: number } {
    const loc = e.location;
    if (loc && typeof loc === 'object') {
      const o = loc as Record<string, unknown>;
      const lat = Number(o.lat ?? o.latitude);
      const lng = Number(o.lng ?? o.longitude);
      return {
        lat: Number.isFinite(lat) ? lat : undefined,
        lng: Number.isFinite(lng) ? lng : undefined,
      };
    }
    return {};
  }

  function buildLocation(place: string, lat: number, lng: number) {
    return {
      name: place,
      address: place,
      lat,
      lng,
      latitude: lat,
      longitude: lng,
    };
  }

  function setSteps(active: number) {
    stepPills.forEach((p) => {
      const n = Number(p.dataset.step);
      p.classList.toggle('is-active', n <= active);
    });
  }

  function setAuthedUI(authed: boolean) {
    workspace.hidden = !authed;
    authPanel.hidden = authed;
    if (!authed) {
      editPanel.hidden = true;
      setSteps(1);
    } else {
      setSteps(2);
    }
  }

  async function refreshMine() {
    const token = getStoredToken();
    if (!token) return;
    show(mineStatus, 'Cargando tus eventos…', 'info');
    try {
      const data = await clientApi<EventItem[] | { items?: EventItem[] }>('/events/mine', {
        token,
      });
      const items = asItemList(data);
      mineStatus.hidden = true;
      setSteps(items.length ? 3 : 2);
      if (!items.length) {
        mineList.innerHTML = '<p class="muted">Todavía no publicaste nada. Usá el formulario de al lado.</p>';
        return;
      }
      mineList.innerHTML = items
        .map((e, idx) => {
          const when = formatWhenParts(pickStartRaw(e)).full;
          const vis = safeString(e.visibility);
          return `<div class="ticket" style="align-items:flex-start">
            <div>
              <strong>${escapeHtml(formatTitle(e))}</strong>
              <div class="muted">${escapeHtml(when)} · ${escapeHtml(visibilityLabel(vis))} · ${escapeHtml(formatPlace(e))}</div>
            </div>
            <div style="display:flex;gap:0.4rem;flex-wrap:wrap">
              <a class="btn btn--ghost" href="/eventos/${encodeURIComponent(String(e.id))}">Ver</a>
              <button class="btn btn--ghost" type="button" data-edit-index="${idx}">Editar</button>
            </div>
          </div>`;
        })
        .join('');

      mineList.querySelectorAll<HTMLButtonElement>('[data-edit-index]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-edit-index'));
          const e = items[idx];
          if (e) openEdit(e);
        });
      });
    } catch (err) {
      const msg = err instanceof ClientApiError ? err.message : 'Error';
      show(mineStatus, `No se pudo listar: ${msg}`, 'error');
      mineList.innerHTML = '';
    }
  }

  function openEdit(e: EventItem) {
    editPanel.hidden = false;
    setSteps(3);
    const coords = locationCoords(e);
    (editForm.elements.namedItem('id') as HTMLInputElement).value = String(e.id);
    (editForm.elements.namedItem('name') as HTMLInputElement).value = formatTitle(e);
    (editForm.elements.namedItem('description') as HTMLTextAreaElement).value =
      safeString(e.description);
    (editForm.elements.namedItem('startDate') as HTMLInputElement).value = toLocalInputValue(
      pickStartRaw(e),
    );
    (editForm.elements.namedItem('endDate') as HTMLInputElement).value =
      toLocalInputValue(pickEndRaw(e)) || toLocalInputValue(pickStartRaw(e));
    (editForm.elements.namedItem('place') as HTMLInputElement).value = formatPlace(e);
    (editForm.elements.namedItem('lat') as HTMLInputElement).value =
      coords.lat != null ? String(coords.lat) : '';
    (editForm.elements.namedItem('lng') as HTMLInputElement).value =
      coords.lng != null ? String(coords.lng) : '';
    (editForm.elements.namedItem('visibility') as HTMLSelectElement).value =
      safeString(e.visibility) || 'public';
    editStatus.hidden = true;
    inviteResult.textContent = '';
    inviteBox.hidden = safeString(e.visibility) !== 'private';
    editPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  authForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const submitter = (ev as SubmitEvent).submitter as HTMLButtonElement | null;
    const action = submitter?.value || 'save';
    const fd = new FormData(authForm);

    if (action === 'login') {
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');
      show(authStatus, 'POST /auth/sign-in…', 'info');
      try {
        const res = await clientApi<{
          accessToken?: string;
          access_token?: string;
          token?: string;
        }>('/auth/sign-in', {
          method: 'POST',
          body: { email, password },
        });
        const token = res.accessToken || res.access_token || res.token || '';
        if (!token) throw new ClientApiError('sign-in OK pero sin accessToken', 200, res);
        setStoredToken(token);
        tokenField.value = token;
        show(authStatus, 'Sesión iniciada.', 'ok');
        setAuthedUI(true);
        await refreshMine();
      } catch (err) {
        const msg = err instanceof ClientApiError ? err.message : 'Error';
        show(
          authStatus,
          `Login falló (${msg}). ¿Nest en Crop PR con /auth/sign-in? Podés pegar un JWT.`,
          'error',
        );
      }
      return;
    }

    const token = String(fd.get('token') || '').trim();
    if (!token) {
      show(authStatus, 'Pegá un token para continuar.', 'error');
      return;
    }
    setStoredToken(token);
    show(authStatus, 'Sesión lista.', 'ok');
    setAuthedUI(true);
    await refreshMine();
  });

  document.getElementById('logout-btn')!.addEventListener('click', () => {
    clearStoredToken();
    tokenField.value = '';
    setAuthedUI(false);
    show(authStatus, 'Sesión cerrada.', 'info');
  });

  document.getElementById('refresh-btn')!.addEventListener('click', () => refreshMine());
  document.getElementById('cancel-edit')!.addEventListener('click', () => {
    editPanel.hidden = true;
  });

  createForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const token = getStoredToken();
    if (!token) {
      show(createStatus, 'Necesitás entrar primero.', 'error');
      return;
    }
    const fd = new FormData(createForm);
    const capacityRaw = String(fd.get('capacity') || '').trim();
    const capacity = capacityRaw ? Number(capacityRaw) : null;
    const publish = (createForm.elements.namedItem('publish') as HTMLInputElement).checked;
    const place = String(fd.get('place') || '').trim();
    const startLocal = String(fd.get('startDate') || '');
    const endLocal = String(fd.get('endDate') || '');
    const startDate = fromLocalInputValue(startLocal);
    const endDate = fromLocalInputValue(endLocal);
    const lat = Number(fd.get('lat'));
    const lng = Number(fd.get('lng'));

    if (!startDate || !endDate) {
      show(createStatus, 'startDate y endDate son obligatorios.', 'error');
      return;
    }
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
      show(createStatus, 'location requiere lat/lng numéricos.', 'error');
      return;
    }

    const payload = {
      name: String(fd.get('name') || '').trim(),
      description: String(fd.get('description') || '').trim(),
      startDate,
      endDate,
      startsAt: startDate,
      endsAt: endDate,
      place,
      placeText: place,
      locationText: place,
      location: buildLocation(place, lat, lng),
      visibility: String(fd.get('visibility') || 'public'),
      status: publish ? 'published' : 'draft',
      publish,
      ticketTypes: [
        {
          name: String(fd.get('ticketName') || 'General'),
          price: Number(fd.get('ticketPrice') || 0),
          capacity,
        },
      ],
    };

    show(createStatus, 'Publicando…', 'info');
    try {
      const created = await clientApi<EventItem>('/events', {
        method: 'POST',
        token,
        body: payload,
      });
      show(createStatus, 'Evento publicado.', 'ok');
      createForm.reset();
      (createForm.elements.namedItem('ticketName') as HTMLInputElement).value = 'General';
      (createForm.elements.namedItem('ticketPrice') as HTMLInputElement).value = '0';
      (createForm.elements.namedItem('lat') as HTMLInputElement).value = '13.6929';
      (createForm.elements.namedItem('lng') as HTMLInputElement).value = '-89.2182';
      (createForm.elements.namedItem('publish') as HTMLInputElement).checked = true;
      await refreshMine();
      if (created?.id) openEdit(created);
    } catch (err) {
      const msg = err instanceof ClientApiError ? err.message : 'Error';
      show(createStatus, `No se pudo crear: ${msg}`, 'error');
    }
  });

  editForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const token = getStoredToken();
    const fd = new FormData(editForm);
    const id = String(fd.get('id') || '');
    const place = String(fd.get('place') || '').trim();
    const startDate = fromLocalInputValue(String(fd.get('startDate') || ''));
    const endDate = fromLocalInputValue(String(fd.get('endDate') || ''));
    const latRaw = String(fd.get('lat') || '').trim();
    const lngRaw = String(fd.get('lng') || '').trim();
    const lat = latRaw ? Number(latRaw) : NaN;
    const lng = lngRaw ? Number(lngRaw) : NaN;

    const payload: Record<string, unknown> = {
      name: String(fd.get('name') || '').trim(),
      description: String(fd.get('description') || '').trim(),
      startDate,
      endDate,
      startsAt: startDate,
      endsAt: endDate,
      place,
      placeText: place,
      locationText: place,
      visibility: String(fd.get('visibility') || 'public'),
    };
    if (Number.isFinite(lat) && Number.isFinite(lng)) {
      payload.location = buildLocation(place, lat, lng);
    }

    show(editStatus, 'Guardando…', 'info');
    try {
      await clientApi(`/events/${encodeURIComponent(id)}`, {
        method: 'PATCH',
        token,
        body: payload,
      });
      show(editStatus, 'Cambios guardados.', 'ok');
      inviteBox.hidden = payload.visibility !== 'private';
      await refreshMine();
    } catch (err) {
      const msg = err instanceof ClientApiError ? err.message : 'Error';
      show(editStatus, `No se pudo editar: ${msg}`, 'error');
    }
  });

  document.getElementById('invite-btn')!.addEventListener('click', async () => {
    const token = getStoredToken();
    const id = (editForm.elements.namedItem('id') as HTMLInputElement).value;
    inviteResult.textContent = 'Creando link…';
    try {
      const res = await clientApi<{
        token?: string;
        inviteToken?: string;
        url?: string;
        inviteUrl?: string;
        link?: string;
      }>(`/events/${encodeURIComponent(id)}/invites`, {
        method: 'POST',
        token,
        body: {},
      });
      let inviteToken = res.token || res.inviteToken || '';
      if (!inviteToken) {
        const url = res.url || res.inviteUrl || res.link || '';
        if (url) {
          try {
            inviteToken = new URL(url, window.location.origin).searchParams.get('invite') || '';
          } catch {
            /* ignore */
          }
        }
      }
      if (!inviteToken) {
        inviteResult.textContent =
          'Invite creado pero sin token reconocible. Revisá el payload con Crop.';
        return;
      }
      const link = `${window.location.origin}/eventos/${encodeURIComponent(id)}?invite=${encodeURIComponent(inviteToken)}`;
      inviteResult.textContent = link;
      try {
        await navigator.clipboard.writeText(link);
        inviteResult.textContent = `${link}\n(copiado)`;
      } catch {
        /* ignore */
      }
    } catch (err) {
      const msg = err instanceof ClientApiError ? err.message : 'Error';
      inviteResult.textContent = `Error: ${msg}`;
    }
  });

  const existing = getStoredToken();
  if (existing) {
    tokenField.value = existing;
    setAuthedUI(true);
    refreshMine();
  } else {
    setAuthedUI(false);
  }

  // Default endDate = startDate + 2h for A1 happy path
  const startInput = createForm.elements.namedItem('startDate') as HTMLInputElement;
  const endInput = createForm.elements.namedItem('endDate') as HTMLInputElement;
  startInput?.addEventListener('change', () => {
    if (!startInput.value) return;
    if (endInput.value) return;
    const d = new Date(startInput.value);
    if (Number.isNaN(d.getTime())) return;
    d.setHours(d.getHours() + 2);
    endInput.value = toLocalInputValue(d);
  });
</script>
