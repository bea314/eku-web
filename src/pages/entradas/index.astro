---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mis entradas · ekü" description="Tu wallet de pases ekü.">
  <div class="pase-page">
    <section class="page-hero page-hero--brand pase-hero">
      <p class="eyebrow">Entradas</p>
      <h1>Mis pases</h1>
      <p>Tickets del wallet · <code class="mono">GET /api/wallet/tickets</code></p>
    </section>

    <div id="entradas-gate" class="panel stack" hidden>
      <p class="muted" style="margin:0">
        Iniciá sesión para ver tus entradas del wallet.
      </p>
      <a class="btn" href="/login?next=/entradas">Entrar</a>
    </div>

    <div id="entradas-status" class="alert alert--info" hidden></div>
    <div id="entradas-list" class="pase-list" aria-live="polite"></div>
  </div>
</BaseLayout>

<script>
  import { paintQrCanvas } from '../../lib/client-qr';
  import {
    clientApi,
    ClientApiError,
    clearStoredToken,
    getStoredToken,
    asItemList,
  } from '../../lib/client-api';
  import { paseRows, type PaseTicket } from '../../lib/pase';
  import type { WalletTicket } from '../../lib/types';
  import { coverUrlOf, escapeHtml, safeString } from '../../lib/safe-display';

  function ticketTitle(t: PaseTicket): string {
    return safeString(t.name) || safeString(t.eventName) || 'Pase ekü';
  }

  function ticketCover(t: PaseTicket): string {
    return coverUrlOf({
      coverImageUrl: t.coverImageUrl,
      image_url: t.image_url,
    });
  }

  function cardHtml(ticket: PaseTicket, code: string, index: number): string {
    const title = escapeHtml(ticketTitle(ticket));
    const type = escapeHtml(ticket.ticketTypeName || 'General');
    const codeSafe = escapeHtml(code);
    const cover = ticketCover(ticket);
    const coverBlock = cover
      ? `<div class="pase-card__cover"><img src="${escapeHtml(cover)}" alt="" loading="lazy" /></div>`
      : '';
    return `
      <article class="pase-card" data-pase-index="${index}">
        <div class="pase-card__body">
          <div class="pase-card__brand">ekü</div>
          ${coverBlock}
          <h2 class="pase-card__title">${title}</h2>
          <p class="pase-card__type">${type}</p>
          <p class="pase-card__code mono">${codeSafe}</p>
        </div>
        <div class="pase-card__perforation" aria-hidden="true"></div>
        <div class="pase-card__qr-wrap">
          <canvas class="pase-card__qr" data-qr-index="${index}" width="168" height="168" aria-label="Código QR de la entrada"></canvas>
          <p class="pase-card__qr-hint muted">Escaneá al ingresar</p>
        </div>
      </article>
    `;
  }

  async function paintQrs(
    list: HTMLElement,
    rows: Array<{ qr: string; index: number }>,
  ) {
    await Promise.all(
      rows.map(async ({ qr, index }) => {
        const canvas = list.querySelector<HTMLCanvasElement>(`canvas[data-qr-index="${index}"]`);
        if (!canvas || !qr) return;
        try {
          await paintQrCanvas(canvas, qr, { size: 168, dark: '#2c3441', light: '#ffffff' });
        } catch {
          /* leave blank */
        }
      }),
    );
  }

  async function load() {
    const gate = document.getElementById('entradas-gate')!;
    const status = document.getElementById('entradas-status')!;
    const list = document.getElementById('entradas-list')!;
    const token = getStoredToken();

    if (!token) {
      gate.hidden = false;
      list.innerHTML = '';
      return;
    }
    gate.hidden = true;

    status.hidden = false;
    status.className = 'alert alert--info';
    status.textContent = 'Cargando wallet…';

    try {
      const raw = await clientApi<
        | WalletTicket[]
        | {
            tickets?: WalletTicket[];
            items?: WalletTicket[];
            qrPayloads?: string[];
          }
      >('/wallet/tickets', { token });

      let tickets: WalletTicket[] = [];
      let qrPayloads: string[] = [];

      if (Array.isArray(raw)) {
        tickets = raw;
      } else if (raw && typeof raw === 'object') {
        tickets = raw.tickets || asItemList(raw.items || []) || [];
        qrPayloads = Array.isArray(raw.qrPayloads) ? raw.qrPayloads : [];
      }

      const normalized: PaseTicket[] = tickets.map((t) => ({
        id: t.id,
        code: t.code || t.ticketCode || t.id,
        ticketCode: t.ticketCode,
        qrPayload: t.qrPayload,
        ticketTypeName: t.ticketTypeName,
        name: t.name || t.eventName || t.event?.name || t.event?.title,
        eventName: t.eventName || t.event?.name || t.event?.title || t.name,
        eventId: t.eventId || t.event?.id,
        status: t.status,
        coverImageUrl: t.coverImageUrl ?? t.event?.coverImageUrl ?? null,
        image_url: t.image_url ?? t.event?.image_url ?? null,
      }));

      if (!qrPayloads.length) {
        qrPayloads = normalized.map((t) => t.qrPayload || t.code || '').filter(Boolean);
      }

      status.hidden = true;
      const rows = paseRows(normalized, qrPayloads);

      if (!rows.length) {
        list.innerHTML = '<p class="muted">No tenés entradas en el wallet todavía.</p>';
        return;
      }

      list.innerHTML = rows.map(({ ticket, code, index }) => cardHtml(ticket, code, index)).join('');
      await paintQrs(list, rows);
    } catch (err) {
      const statusCode = err instanceof ClientApiError ? err.status : 0;
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'No se pudo cargar el wallet';
      if (statusCode === 401 || /invalid token/i.test(msg)) {
        clearStoredToken();
        gate.hidden = false;
        status.hidden = true;
        list.innerHTML = '';
        return;
      }
      status.className = 'alert alert--error';
      status.textContent = msg;
    }
  }

  load();
</script>
