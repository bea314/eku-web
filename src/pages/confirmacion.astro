---
import BaseLayout from '../layouts/BaseLayout.astro';

const orderId = Astro.url.searchParams.get('orderId') || '';
const email = Astro.url.searchParams.get('email') || '';
const evidence = Astro.url.searchParams.get('evidence') || '';
const eventId = Astro.url.searchParams.get('eventId') || '';

const codes = evidence
  .split(',')
  .map((s) => s.trim())
  .filter(Boolean);
---

<BaseLayout title="Listo · ekü">
  <div class="page--narrow" style="margin-inline:auto">
    <section class="page-hero page-hero--brand">
      <p class="eyebrow">Listo</p>
      <h1>Tu lugar está reservado</h1>
      <p>Guardá el código de tu entrada. Lo vas a necesitar el día del evento.</p>
    </section>

    {!orderId ? (
      <div class="alert alert--error">
        No hay una orden en esta página. Completá la reserva desde el evento.
      </div>
    ) : (
      <div class="panel stack">
        <div class="alert alert--ok">Reserva confirmada</div>
        <div>
          <div class="detail-meta__label">Order ID</div>
          <p class="confirm-order">{orderId}</p>
        </div>
        {email && (
          <div>
            <div class="detail-meta__label">Email</div>
            <p style="margin:0.25rem 0 0">{email}</p>
          </div>
        )}
        <div>
          <div class="detail-meta__label">Tu entrada</div>
          {codes.length ? (
            <ul class="evidence">
              {codes.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          ) : (
            <p class="muted">
              La API no devolvió un código de ticket visible. Revisá el payload de confirm con Crop.
            </p>
          )}
        </div>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:0.5rem">
          {eventId && (
            <a class="btn btn--ghost" href={`/eventos/${eventId}`}>
              Ver evento
            </a>
          )}
          <a class="btn" href="/eventos">Más eventos</a>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
