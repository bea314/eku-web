---
import BaseLayout from '../../layouts/BaseLayout.astro';

/** U9 — empty-hide: Mutual / Hosting / Past / bio / social hidden when empty.
 *  Mutual stubs = hide (no fake Mutual UI). */
const profile = {
  displayName: 'Invitado ekü',
  bio: '',
  socialLinks: [] as Array<{ label: string; href: string }>,
  mutualCount: 0,
  hosting: [] as Array<{ id: string; name: string }>,
  past: [] as Array<{ id: string; name: string }>,
  upcoming: [] as Array<{ id: string; name: string }>,
  eventCount: 0,
  friendCount: 0,
};

const showBio = Boolean(profile.bio?.trim());
const showSocial = profile.socialLinks.length > 0;
const showMutual = profile.mutualCount > 0;
const showHosting = profile.hosting.length > 0;
const showPast = profile.past.length > 0;
const showUpcoming = profile.upcoming.length > 0;
---

<BaseLayout title="Perfil · ekü" description="Tu perfil en ekü.">
  <section class="profile-hero">
    <div class="profile-avatar" aria-hidden="true">ü</div>
    <div>
      <p class="eyebrow">Perfil</p>
      <h1 style="margin:0">{profile.displayName}</h1>
      {showBio && <p class="profile-bio">{profile.bio}</p>}
      {showSocial && (
        <ul class="profile-social">
          {profile.socialLinks.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="profile-stats" style="margin-top:0.85rem">
        {profile.eventCount > 0 && (
          <div class="profile-stat">
            <strong>{profile.eventCount}</strong>
            <span>Eventos</span>
          </div>
        )}
        {profile.friendCount > 0 && (
          <div class="profile-stat">
            <strong>{profile.friendCount}</strong>
            <span>Amigos</span>
          </div>
        )}
        {showMutual && (
          <div class="profile-stat">
            <strong>{profile.mutualCount}</strong>
            <span>Mutual</span>
          </div>
        )}
      </div>
    </div>
    <div class="profile-menu">
      <button class="profile-menu__btn" type="button" id="profile-more" aria-expanded="false" aria-haspopup="true">
        ⋯
      </button>
      <div class="profile-menu__pop" id="profile-more-pop" hidden role="menu">
        <button type="button" data-stub="block" role="menuitem">Block (stub)</button>
        <button type="button" data-stub="report" role="menuitem">Report (stub)</button>
      </div>
    </div>
  </section>

  {showHosting && (
    <section class="profile-section" aria-labelledby="hosting-h">
      <h2 id="hosting-h" class="profile-section__title">Hosting</h2>
      <ul class="profile-list">
        {profile.hosting.map((e) => (
          <li>
            <a href={`/eventos/${e.id}`}>{e.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="profile-tabs" role="tablist">
    <button class="chip is-active" type="button" data-tab="upcoming">Próximos</button>
    {showPast && (
      <button class="chip" type="button" data-tab="past">Pasados</button>
    )}
  </div>

  <div id="profile-panel" class="panel">
    {showUpcoming ? (
      <ul class="profile-list" id="profile-upcoming-list">
        {profile.upcoming.map((e) => (
          <li>
            <a href={`/eventos/${e.id}`}>{e.name}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted" style="margin:0" id="profile-empty">
        Todavía no hay entradas próximas. Reservá desde un evento público.
      </p>
    )}
  </div>

  {showPast && (
    <template id="profile-past-tpl">
      <ul class="profile-list">
        {profile.past.map((e) => (
          <li>
            <a href={`/eventos/${e.id}`}>{e.name}</a>
          </li>
        ))}
      </ul>
    </template>
  )}
</BaseLayout>

<script>
  const toast = document.getElementById('nav-toast');
  function flash(msg: string) {
    if (!toast) return;
    toast.hidden = false;
    toast.textContent = msg;
    window.setTimeout(() => {
      toast.hidden = true;
    }, 2400);
  }

  const more = document.getElementById('profile-more')!;
  const pop = document.getElementById('profile-more-pop')!;
  more.addEventListener('click', () => {
    const open = pop.hidden;
    pop.hidden = !open;
    more.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.addEventListener('click', (ev) => {
    if (!(ev.target as HTMLElement).closest('.profile-menu')) {
      pop.hidden = true;
      more.setAttribute('aria-expanded', 'false');
    }
  });
  pop.querySelectorAll<HTMLButtonElement>('[data-stub]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const kind = btn.dataset.stub;
      flash(kind === 'block' ? 'Block — UI stub (sin endpoint).' : 'Report — UI stub (sin endpoint).');
      pop.hidden = true;
    });
  });

  const panel = document.getElementById('profile-panel')!;
  const pastTpl = document.getElementById('profile-past-tpl') as HTMLTemplateElement | null;
  const upcomingHtml = panel.innerHTML;
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((t) => t.classList.toggle('is-active', t === tab));
      if (tab.dataset.tab === 'past' && pastTpl) {
        panel.innerHTML = '';
        panel.appendChild(pastTpl.content.cloneNode(true));
      } else {
        panel.innerHTML = upcomingHtml;
      }
    });
  });
</script>
