---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Perfil · ekü" description="Tu perfil en ekü.">
  <div id="profile-root">
    <div class="alert alert--info">Cargando perfil…</div>
  </div>
</BaseLayout>

<script>
  import {
    asItemList,
    clientApi,
    ClientApiError,
    clearStoredToken,
    getStoredToken,
  } from '../../lib/client-api';
  import type { AuthMeUser, ProfileEventRef } from '../../lib/profile-types';
  import { escapeHtml, safeString } from '../../lib/safe-display';

  const root = document.getElementById('profile-root')!;

  function softGate(reason?: string) {
    root.innerHTML = `
      <section class="profile-hero">
        <div class="profile-avatar" aria-hidden="true">ü</div>
        <div>
          <p class="eyebrow">Perfil</p>
          <h1 style="margin:0">Invitado ekü</h1>
          <p class="muted" style="margin:0.35rem 0 0">
            Iniciá sesión en Organizador para cargar tu perfil Nest.
          </p>
        </div>
      </section>
      <div class="panel stack">
        <p class="muted" style="margin:0">${
          reason
            ? escapeHtml(reason)
            : 'Sin sesión — Mutual / Hosting / Past / bio / social ocultos (empty-hide).'
        }</p>
        <a class="btn" href="/organizador">Ir a Organizador</a>
      </div>
    `;
  }

  function flash(msg: string) {
    const toast = document.getElementById('nav-toast');
    if (!toast) return;
    toast.hidden = false;
    toast.textContent = msg;
    window.setTimeout(() => {
      toast.hidden = true;
    }, 2400);
  }

  function displayNameOf(me: AuthMeUser): string {
    const direct = safeString(me.displayName) || safeString(me.name);
    if (direct) return direct;
    const parts = [me.firstName, me.lastName].map((p) => safeString(p)).filter(Boolean);
    if (parts.length) return parts.join(' ');
    return safeString(me.email) || 'Invitado ekü';
  }

  function socialLinksOf(me: AuthMeUser): Array<{ label: string; href: string }> {
    const out: Array<{ label: string; href: string }> = [];
    if (Array.isArray(me.socialLinks)) {
      for (const s of me.socialLinks) {
        const href = safeString(s?.href || s?.url);
        const label = safeString(s?.label || s?.name) || href;
        if (href) out.push({ label, href });
      }
    }
    if (me.social && typeof me.social === 'object') {
      for (const [k, v] of Object.entries(me.social)) {
        const href = safeString(v);
        if (href) out.push({ label: k, href });
      }
    }
    for (const [label, key] of [
      ['Instagram', 'instagram'],
      ['Twitter', 'twitter'],
      ['TikTok', 'tiktok'],
      ['Web', 'website'],
    ] as const) {
      const href = safeString(me[key]);
      if (href && !out.some((x) => x.href === href)) out.push({ label, href });
    }
    return out;
  }

  function mutualCountOf(me: AuthMeUser): number {
    if (typeof me.mutualCount === 'number' && me.mutualCount > 0) return me.mutualCount;
    if (Array.isArray(me.mutuals) && me.mutuals.length > 0) return me.mutuals.length;
    return 0;
  }

  function eventLabel(e: ProfileEventRef): string {
    return safeString(e.name) || safeString(e.title) || 'Evento';
  }

  function listHtml(events: ProfileEventRef[]): string {
    if (!events.length) return '';
    return `<ul class="profile-list">${events
      .map(
        (e) =>
          `<li><a href="/eventos/${encodeURIComponent(e.id)}">${escapeHtml(eventLabel(e))}</a></li>`,
      )
      .join('')}</ul>`;
  }

  function wireMenu(showMutualStub: boolean) {
    const more = document.getElementById('profile-more');
    const pop = document.getElementById('profile-more-pop');
    if (!more || !pop) return;
    more.addEventListener('click', () => {
      const open = pop.hidden;
      pop.hidden = !open;
      more.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', (ev) => {
      if (!(ev.target as HTMLElement).closest('.profile-menu')) {
        pop.hidden = true;
        more.setAttribute('aria-expanded', 'false');
      }
    });
    pop.querySelectorAll<HTMLButtonElement>('[data-stub]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.dataset.stub;
        flash(
          kind === 'mutual'
            ? 'Mutual — UI stub (sin grafo Nest).'
            : kind === 'block'
              ? 'Block — UI stub (sin endpoint).'
              : 'Report — UI stub (sin endpoint).',
        );
        pop.hidden = true;
      });
    });
    if (!showMutualStub) {
      pop.querySelector('[data-stub="mutual"]')?.remove();
    }
  }

  function wireTabs(upcomingHtml: string, pastHtml: string | null) {
    const panel = document.getElementById('profile-panel');
    if (!panel) return;
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('[data-tab]').forEach((t) => t.classList.toggle('is-active', t === tab));
        if (tab.dataset.tab === 'past' && pastHtml) {
          panel.innerHTML = pastHtml;
        } else {
          panel.innerHTML = upcomingHtml;
        }
      });
    });
  }

  async function loadProfileEvents(
    token: string,
    path: '/profiles/me/hosted' | '/profiles/me/attended',
    scope: 'upcoming' | 'past' | 'all',
  ): Promise<ProfileEventRef[]> {
    try {
      const raw = await clientApi<ProfileEventRef[] | { items?: ProfileEventRef[] }>(path, {
        token,
        searchParams: { scope },
      });
      return asItemList(raw).filter((e) => e && typeof e.id === 'string' && e.id);
    } catch (err) {
      if (err instanceof ClientApiError && (err.status === 404 || err.status === 401)) {
        return [];
      }
      throw err;
    }
  }

  async function load() {
    const token = getStoredToken();
    if (!token) {
      softGate();
      return;
    }

    try {
      const me = await clientApi<AuthMeUser>('/auth/me', { token });
      const [hostingUpcoming, hostingPast, attendedUpcoming, attendedPast] = await Promise.all([
        loadProfileEvents(token, '/profiles/me/hosted', 'upcoming'),
        loadProfileEvents(token, '/profiles/me/hosted', 'past'),
        loadProfileEvents(token, '/profiles/me/attended', 'upcoming'),
        loadProfileEvents(token, '/profiles/me/attended', 'past'),
      ]);

      const name = displayNameOf(me);
      const bio = safeString(me.bio).trim();
      const social = socialLinksOf(me);
      const mutual = mutualCountOf(me);
      const avatar = safeString(me.avatarUrl) || safeString(me.imageUrl);
      const eventCount =
        typeof me.eventCount === 'number'
          ? me.eventCount
          : hostingUpcoming.length + hostingPast.length + attendedUpcoming.length + attendedPast.length;
      const friendCount = typeof me.friendCount === 'number' ? me.friendCount : 0;

      const showBio = Boolean(bio);
      const showSocial = social.length > 0;
      const showMutual = mutual > 0;
      const showHosting = hostingUpcoming.length > 0 || hostingPast.length > 0;
      const hostingAll = [...hostingUpcoming, ...hostingPast];
      const showPast = attendedPast.length > 0;
      const showUpcoming = attendedUpcoming.length > 0;

      const upcomingHtml = showUpcoming
        ? listHtml(attendedUpcoming)
        : `<p class="muted" style="margin:0">Todavía no hay entradas próximas.</p>`;
      const pastHtml = showPast ? listHtml(attendedPast) : null;

      root.innerHTML = `
        <section class="profile-hero">
          ${
            avatar
              ? `<img class="profile-avatar profile-avatar--img" src="${escapeHtml(avatar)}" alt="" width="88" height="88" />`
              : `<div class="profile-avatar" aria-hidden="true">ü</div>`
          }
          <div>
            <p class="eyebrow">Perfil</p>
            <h1 style="margin:0">${escapeHtml(name)}</h1>
            ${showBio ? `<p class="profile-bio">${escapeHtml(bio)}</p>` : ''}
            ${
              showSocial
                ? `<ul class="profile-social">${social
                    .map(
                      (s) =>
                        `<li><a href="${escapeHtml(s.href)}" rel="noopener noreferrer" target="_blank">${escapeHtml(s.label)}</a></li>`,
                    )
                    .join('')}</ul>`
                : ''
            }
            <div class="profile-stats" style="margin-top:0.85rem">
              ${
                eventCount > 0
                  ? `<div class="profile-stat"><strong>${eventCount}</strong><span>Eventos</span></div>`
                  : ''
              }
              ${
                friendCount > 0
                  ? `<div class="profile-stat"><strong>${friendCount}</strong><span>Amigos</span></div>`
                  : ''
              }
              ${
                showMutual
                  ? `<div class="profile-stat"><strong>${mutual}</strong><span>Mutual</span></div>`
                  : ''
              }
            </div>
          </div>
          <div class="profile-menu">
            <button class="profile-menu__btn" type="button" id="profile-more" aria-expanded="false" aria-haspopup="true">⋯</button>
            <div class="profile-menu__pop" id="profile-more-pop" hidden role="menu">
              ${showMutual ? `<button type="button" data-stub="mutual" role="menuitem">Mutual (stub)</button>` : ''}
              <button type="button" data-stub="block" role="menuitem">Block (stub)</button>
              <button type="button" data-stub="report" role="menuitem">Report (stub)</button>
            </div>
          </div>
        </section>

        ${
          showHosting
            ? `<section class="profile-section" aria-labelledby="hosting-h">
                <h2 id="hosting-h" class="profile-section__title">Hosting</h2>
                ${listHtml(hostingAll)}
              </section>`
            : ''
        }

        <div class="profile-tabs" role="tablist">
          <button class="chip is-active" type="button" data-tab="upcoming">Próximos</button>
          ${showPast ? `<button class="chip" type="button" data-tab="past">Pasados</button>` : ''}
        </div>
        <div id="profile-panel" class="panel">${upcomingHtml}</div>
      `;

      wireMenu(showMutual);
      wireTabs(upcomingHtml, pastHtml);
    } catch (err) {
      const status = err instanceof ClientApiError ? err.status : 0;
      const msg =
        err instanceof ClientApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Error';
      // Invalid / missing Nest auth → soft gate (no broken "Invalid Token" UI)
      if (status === 401 || status === 403 || /invalid token/i.test(msg)) {
        clearStoredToken();
        softGate('Sesión expirada o token inválido. Volvé a iniciar sesión en Organizador.');
        return;
      }
      root.innerHTML = `
        <div class="alert alert--error">${escapeHtml(msg)}</div>
        <div class="panel stack" style="margin-top:1rem">
          <p class="muted" style="margin:0">Requiere Bearer de <code class="mono">POST /auth/sign-in</code>.</p>
          <a class="btn" href="/organizador">Ir a Organizador</a>
        </div>
      `;
    }
  }

  load();
</script>
