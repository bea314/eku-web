---
import '../styles/global.css';
import { getApiBaseUrl } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph / share (U12) — absolute URLs preferred for image/url */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  ogType?: string;
  twitterCard?: 'summary' | 'summary_large_image';
}

const {
  title = 'ekü',
  description = 'Eventos y planes en El Salvador — boletería + tercer lugar.',
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  ogType = 'website',
  twitterCard = 'summary_large_image',
} = Astro.props;

const pathname = Astro.url.pathname;
let apiBase = '';
try {
  apiBase = getApiBaseUrl();
} catch {
  apiBase = '';
}

const pageTitle = title.includes('ekü') || title.includes('EKÜ') ? title : `${title} · ekü`;
const shareTitle = ogTitle || pageTitle;
const shareDescription = ogDescription || description;
const shareUrl = ogUrl || new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin).href;
const shareImage = ogImage || new URL('/favicon-32.png', Astro.url.origin).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="eku-api-base" content={apiBase} />

    <!-- U12 Open Graph (native; check with opengraph.xyz — do not call it) -->
    <meta property="og:site_name" content="ekü" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content="es_SV" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="canonical" href={shareUrl} />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="ekü, inicio">
          <img class="brand__logo" src="/eku-logo.svg" alt="ekü" width="112" height="36" />
        </a>
        <nav class="nav" aria-label="Principal">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Inicio</a>
          <a
            href="/eventos"
            aria-current={pathname.startsWith('/eventos') && !pathname.includes('/checkout') ? 'page' : undefined}
          >
            Eventos
          </a>
          <a
            href="/organizador"
            aria-current={pathname.startsWith('/organizador') || pathname.startsWith('/org') ? 'page' : undefined}
          >
            Organizador
          </a>
          <a
            href="/entradas"
            aria-current={pathname.startsWith('/entradas') ? 'page' : undefined}
          >
            Entradas
          </a>
          <div class="nav-tools" aria-label="Cuenta">
            <button
              class="nav-stub nav-stub--icon"
              type="button"
              id="nav-notifications"
              title="Notificaciones"
              aria-label="Notificaciones"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 22a2.2 2.2 0 0 0 2.1-1.5H9.9A2.2 2.2 0 0 0 12 22Zm7-4.5H5l1.3-1.4V11a5.7 5.7 0 0 1 4.2-5.5V5a1.5 1.5 0 1 1 3 0v.5A5.7 5.7 0 0 1 17.7 11v5.1L19 17.5Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="nav-stub__dot" aria-hidden="true"></span>
            </button>
            <a
              class="nav-stub"
              href="/perfil"
              id="nav-profile"
              title="Perfil"
              aria-label="Perfil"
              aria-current={pathname.startsWith('/perfil') ? 'page' : undefined}
            >
              <span class="nav-avatar" aria-hidden="true">tú</span>
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p><strong>ekü</strong> — eventos y planes en El Salvador · registro gratis.</p>
      </div>
    </footer>

    <div id="nav-toast" class="toast-stub" hidden role="status"></div>

    <script>
      const toast = document.getElementById('nav-toast');
      function flash(msg: string) {
        if (!toast) return;
        toast.hidden = false;
        toast.textContent = msg;
        window.clearTimeout((flash as unknown as { _t?: number })._t);
        (flash as unknown as { _t?: number })._t = window.setTimeout(() => {
          toast.hidden = true;
        }, 2600);
      }
      document.getElementById('nav-notifications')?.addEventListener('click', () => {
        flash('Notificaciones próximamente — sin romper la página.');
      });
    </script>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
