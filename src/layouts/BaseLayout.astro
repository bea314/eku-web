---
import '../styles/global.css';
import { getApiBaseUrl } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ekü',
  description = 'Boletería y cultura local — eventos cerca de ti.',
} = Astro.props;

const pathname = Astro.url.pathname;
let apiBase = '';
try {
  apiBase = getApiBaseUrl();
} catch {
  apiBase = '';
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="eku-api-base" content={apiBase} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..700&family=Figtree:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title.includes('ekü') ? title : `${title} · ekü`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/eventos">ekü<span>.</span></a>
        <nav class="nav" aria-label="Principal">
          <a href="/eventos" aria-current={pathname.startsWith('/eventos') && !pathname.includes('/checkout') ? 'page' : undefined}>
            Eventos
          </a>
          <a href="/organizador" aria-current={pathname.startsWith('/organizador') || pathname.startsWith('/org') ? 'page' : undefined}>
            Organizador
          </a>
        </nav>
      </div>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>ekü — boletería + tercer lugar + cultura local.</p>
      </div>
    </footer>
  </body>
</html>
