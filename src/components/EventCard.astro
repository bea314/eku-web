---
import type { EventItem } from '../lib/types';
import { eventPlace, eventStartsAt, eventTitle, formatDateTime } from '../lib/format';

interface Props {
  event: EventItem;
  index?: number;
}

const { event, index = 0 } = Astro.props;
const title = eventTitle(event);
const when = formatDateTime(eventStartsAt(event));
const place = eventPlace(event);
const cover = event.coverUrl || event.imageUrl || '';
const d = eventStartsAt(event) ? new Date(eventStartsAt(event)!) : null;
const month = d && !Number.isNaN(d.getTime())
  ? new Intl.DateTimeFormat('es', { month: 'short' }).format(d).replace('.', '')
  : '—';
const day = d && !Number.isNaN(d.getTime()) ? String(d.getDate()) : '?';
---

<a
  class="event-card"
  href={`/eventos/${event.id}`}
  style={`animation-delay: ${Math.min(index, 8) * 35}ms`}
>
  <div class="event-card__media">
    {cover ? (
      <img src={cover} alt="" loading="lazy" />
    ) : (
      <div class="event-card__media-fallback">
        <span>ekü</span>
      </div>
    )}
    <div class="event-card__date-chip" aria-label={when}>
      <span class="month">{month}</span>
      <span class="day">{day}</span>
    </div>
  </div>
  <div class="event-card__body">
    <h2>{title}</h2>
    <div class="event-card__meta">
      <span>{when}</span>
      <span>{place}</span>
    </div>
    <div class="event-card__cta">
      <span class="event-card__price">Gratis</span>
      <span class="event-card__action">Ver evento →</span>
    </div>
  </div>
</a>
